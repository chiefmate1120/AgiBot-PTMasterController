<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.11">
  <GVL Name="GVL_SystemParameters" Id="{6ebbff17-e303-4344-870e-d2871229e24f}">
    <Declaration><![CDATA[VAR_GLOBAL CONSTANT
	
	g_SWVersion : STRING := 'PT(1.0.0.1)';
	
	g_mArmNum :INT := 2;	
	g_mJntNum :INT := 7;	
	g_sArmNum :INT := 4;	
	g_sJntNum :INT := 8;
	g_cartDofs :INT :=6;
	g_deviceNum :INT:=3;
	g_cJntNum :INT := 4;
	
	// control loop interval for each task
	g_armCtrlCycleTime :LREAL :=0.00025;
	g_armCtrlFreq :LREAL :=1.0/g_armCtrlCycleTime;
	g_armDynamicCycleTime :LREAL := 0.001;
	g_armDynamicFreq :LREAL := 1.0/g_armDynamicCycleTime;
	g_cartCtrlCycleTime :LREAL := 0.001;
	g_cartCtrlFreq :LREAL := 1.0/g_cartCtrlCycleTime;
	g_safetyCheckCycleTime :LREAL := 0.001;
	
	// wait time before robot init  for ethercat to stablize 
	g_robotInitWaitTime : LREAL := 2.0;
	g_robotSafetyCheckWaitTime : LREAL :=3.0;
	g_robotSafetyDriveOPWaitTime : LREAL :=5.0;
	g_robotSafetyReadFileWaitTime : LREAL :=3.0;
	
	
	//RECIPE
	RecipeDefinitionName : STRING := 'MatserArmLinkENCValue';
	RecipeDefinitionNameCart : STRING := 'MasterCartLinkENCValue';
	RecipeDefinitionNameMonitor : STRING := 'MonitorAngleParameters';
	RecipeDefinitionNameGravity : STRING := 'MasterArmGravityParams';
	
	//device NetID  and device box addr
	g_deviceName : ARRAY [1..3] OF T_MaxString:=['LeftArm','RightArm','MSCommunication'];
	g_armDeviceJntName : ARRAY [1..7] OF T_MaxString:=['Joint12','Joint12','Joint3','Joint4','Joint5','Joint6','Joint7'];
	g_cartDeviceJntName : ARRAY [1..4] OF T_MaxString:=['Cart1','Cart2','Cart3','Cart4'];
END_VAR

VAR_GLOBAL
	//slave arms and setup arms NetId
	g_masterArmNetID: ARRAY[1..g_mArmNum] OF T_AmsNetId :=['169.254.122.138.6.1','169.254.122.138.3.1'];
	
	//cart device NetId
	g_masterCartNetID: T_AmsNetId := '169.254.122.138.5.1';
	
	//MSCommunication device NetId
	g_masterMSComNetID: T_AmsNetId;
	
	//slave joint EtherCAT addr
	g_masterJointNetPort:ARRAY[1..g_mArmNum,1..g_mJntNum] OF UINT:=[1001,    1001,	1002,	1003,	1004,	1005,	1006,
																															1001,    1001,	1002,	1003,	1004,	1005,	1006	];
	
	//cart joint EtherCAT addr
	g_cartJointNetPort :ARRAY[1..g_cJntNum] OF UINT:=[1008,    1010,	1007,	1009];
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>