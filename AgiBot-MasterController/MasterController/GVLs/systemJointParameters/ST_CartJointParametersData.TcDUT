<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_CartJointParametersData" Id="{4c5b1ae6-f61e-4fef-93d0-ca1e9fef0e5c}">
    <Declaration><![CDATA[TYPE ST_CartJointParametersData :
STRUCT
	
	m_incEncoderRes :ARRAY[1..4] OF DINT :=[4(65536)];
	m_absEncoderRes :ARRAY[1..4] OF DINT :=[16777216,131072,16777216,16777216];
	
	// reduction ratio
	m_motorReduction :ARRAY[1..4] OF LREAL :=[2*pi/0.0004682,3317.76,2*pi/0.0004682,1.5*138.0/5*2*pi/0.004];
	// TODO: need to be verified, especially joint2
	m_absEncoderReduction :ARRAY[1..4] OF LREAL :=[1.534, 1 , 1.534, 1.534];// 2*pi/(reduction*g_absEncoderRes)=Line_Resolution_car(from old code, 0.001*2/2^13)
	
	// motor parameters
	m_motorTrqConst :ARRAY[1..4] OF LREAL :=[4(0.0292)];
	m_motorMaxCurrent :ARRAY[1..4] OF LREAL :=[4(1000)];//mA
	
	// motor and absEncoder direction
	m_motorDir :ARRAY[1..4] OF INT :=[1, -1, 1, 1];
	m_asbEncoderDir :ARRAY[1..4] OF INT :=[-1, -1, -1, 1];
																 
	// joint position limit
	m_minJntPos: ARRAY[1..4] OF LREAL:=[0,-(56.24901883)*g_deg2Rad,0,0];
	m_maxJntPos: ARRAY[1..4] OF LREAL:=[0.40,-(21.7523482+2)*g_deg2Rad,0.30,0.20];
	
	// joint motion velocity 
	m_jntCtrlMotionVel :ARRAY[1..7] OF LREAL :=[0.015,2*g_deg2Rad,0.01,0.0075]; //0.0075
	m_jntCtrlMotionAcc :ARRAY[1..7] OF LREAL :=[0.015*2,2*2*g_deg2Rad,0.01*2,0.0075*2]; //0.0075
	
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>